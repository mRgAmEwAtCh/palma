# Port published on the Docker host. Use BIND_ADDRESS=127.0.0.1 to keep it local-only (e.g. until OIDC is configured)
BIND_ADDRESS=0.0.0.0
PORT=8080

# URL you open in the browser; used to build the OIDC redirect URI (<PUBLIC_URL>/auth/callback)
PUBLIC_URL=http://192.168.1.10:8080

# Optional session secret; generated and persisted in /data when empty
SESSION_SECRET=
# Set to true once served via HTTPS (reverse proxy)
SESSION_HTTPS_ONLY=false

# ── Authentication ───────────────────────────────────────────────────────────
# If OIDC_ISSUER and OIDC_CLIENT_ID are set, login goes through Authentik.
# Otherwise the local fallback login with ADMIN_USERNAME / ADMIN_PASSWORD is used.

# Leave authentication variables empty to choose local login or OIDC in the first-run wizard.
# Optional local fallback account; leave empty to configure authentication in the wizard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Authentik OIDC: Applications → Create with provider (OAuth2/OpenID, confidential client)
# The wizard can persist these settings without an .env file; complete environment OIDC takes precedence.
#   Redirect URI: <PUBLIC_URL>/auth/callback   Scopes: openid, email, profile
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional comma-separated Authentik groups allowed to log in (empty = any user the app is bound to)
OIDC_ALLOWED_GROUPS=
# Only for local development. Never expose an instance with auth disabled.
AUTH_DISABLED=false

# Timezone for cron schedules (e.g. Europe/Berlin)
TIMEZONE=UTC

# ── Ansible ──────────────────────────────────────────────────────────────────
DEFAULT_SSH_USER=root
# Host directory for persistent controller keys; Docker creates it if absent.
SSH_KEY_DIR=./ssh
# Key file inside the container; generated by the wizard if not provided.
# To supply existing keys, add a read-only host mount at /ssh-keys in Compose.
# They are copied into the persistent SSH bind mount with strict permissions.
SSH_KEY_PATH=/home/app/.ssh/id_ed25519
